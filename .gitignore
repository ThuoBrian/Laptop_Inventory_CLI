# ── Rust build output ─────────────────────────────────────────────────────
/target/

# Cargo.lock is committed for binary crates (applications).
# Remove this line only if this becomes a library.

# Rustfmt backup files
**/*.rs.bk
**/*.rs.swp

# Windows debug symbols
*.pdb

# ── Secrets / environment ─────────────────────────────────────────────────
.env
.env.local
.env.*
# Keep .env.example committed so new contributors know what to set.
!.env.example

*.key
*.pem
secrets/

# ── Cargo local config ────────────────────────────────────────────────────
# Only the Cargo registry/git cache is excluded — NOT .cargo/config.toml,
# which is project config and should be version-controlled.
.cargo/registry/
.cargo/git/

# ── IDEs & editors ────────────────────────────────────────────────────────
.vscode/
*.code-workspace
.idea/
*.iml

# ── OS-generated files ────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Test / coverage artifacts ─────────────────────────────────────────────
*.profraw
*.profdata
coverage/
tarpaulin-report.html

# ── Server runtime files ──────────────────────────────────────────────────
.server.pid
server.log

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
